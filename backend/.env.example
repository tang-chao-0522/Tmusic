PORT=4100
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/tmusic
REDIS_URL=redis://localhost:6379
NETEASE_API_URL=http://localhost:3000

# Personal-study fallback only. Prefer encrypted per-user credentials after QR binding.
# NETEASE_COOKIE=MUSIC_U=...

# In development, an encryption key is generated under backend/.local/ if omitted.
# In production, set a stable base64 key decoding to exactly 32 bytes.
CREDENTIAL_ENCRYPTION_KEY=

# AI login session signature. Required in production; use a stable random value.
AI_SESSION_SECRET=
# Optional path to a separate JSON model configuration file.
# Default: backend/config/agent-model.json
AI_MODEL_CONFIG_PATH=
# Optional Pi Durable SQLite file path. Default: backend/.local/agent.sqlite
AI_DATA_PATH=
# Model credentials are supplied by the provider, for example:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
