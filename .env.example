# API
PORT=4100
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/tmusic
REDIS_URL=redis://localhost:6379
# Required in production: random secret for room session cookies and short-lived realtime tickets.
ROOM_SESSION_SECRET=

# Compatible Netease API service. Keep it private/local for personal study.
NETEASE_API_URL=http://localhost:3000

# 32-byte base64 key for AES-256-GCM credential encryption.
# Generate locally and never commit the real value.
CREDENTIAL_ENCRYPTION_KEY=

# Production Docker Compose reads the root .env and passes these to the API container.
# Set the key for the provider selected in backend/config/agent-model.json.
AI_SESSION_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web
VITE_API_URL=http://localhost:4100/api/v1
VITE_REALTIME_URL=http://localhost:4100

# WeChat developer tools (set in the shell before npm run dev:mini)
TARO_APP_API_URL=http://127.0.0.1:4100/api/v1
